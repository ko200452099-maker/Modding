+WAIT(0); Static[129]=0;
+Label_5(); Label_6();
+NETWORK_SET_THIS_SCRIPT_IS_NETWORK_SCRIPT(18,0,PLAYER_ID());
+if (IS_WARNING_MESSAGE_ACTIVE()||IS_PAUSE_MENU_ACTIVE()) return;
+if (Static[130]) Label_9();
